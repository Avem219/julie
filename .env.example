# ---- Standalone edition (npm start) ----
NODE_ENV=development
PORT=3000
# SQLite file (created automatically). Use a persistent disk in production.
DATABASE_PATH=./data/julie.db
# Required in production (openssl rand -hex 32). In development a random one is generated into ./data/.dev-pepper
API_KEY_HASH_PEPPER=
# Set to 1 only when behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=0

# Payments: webhook signing secret shared with your payment provider (>= 16 chars). Unset = payments reported as not configured.
PAYMENT_WEBHOOK_SECRET=

# Julie AI: all three required, otherwise the tutor reports "not configured"
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=

# Dev sample data only (never used in production): password for seeded @example.test users
JULIE_DEV_SEED_PASSWORD=

# ---- Production port (prisma/schema.prisma) — not used by the standalone edition ----
# DATABASE_URL=postgresql://julie:CHANGE_ME@localhost:5432/julie?schema=public
# FIREBASE_PROJECT_ID= / FIREBASE_CLIENT_EMAIL= / FIREBASE_PRIVATE_KEY=
